// Schema do protótipo: SQLite para rodar localmente sem instalar banco.
// No deploy do Render, scripts/use-postgres.mjs troca o provider para "postgresql".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Instituição única do sistema (Colégio Estadual P. Kennedy).
// Mantida como registro para agrupar usuários, faltas e avisos.
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  absences AbsenceRequest[]
  notices  Notice[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("EMPLOYEE") // ADMIN | EMPLOYEE
  staffType    String    @default("FUNCIONARIO") // PROFESSOR | FUNCIONARIO
  position     String? // cargo livre para funcionários (ex.: monitor, limpeza)
  status       String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  reviewNote   String? // observação da administração na aprovação/reprovação
  approvedAt   DateTime?
  approvedById String?
  companyId    String
  hasAvatar    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedBy    User?            @relation("Approver", fields: [approvedById], references: [id])
  approvals     User[]           @relation("Approver")
  absences      AbsenceRequest[] @relation("Requester")
  reviews       AbsenceRequest[] @relation("Reviewer")
  notices       Notice[]         @relation("Author")
  receivedNotices Notice[]       @relation("Target")
  noticeReads   NoticeRead[]
  avatar        UserAvatar?
}

model UserAvatar {
  userId    String   @id
  data      Bytes
  type      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AbsenceRequest {
  id            String    @id @default(cuid())
  userId        String
  companyId     String
  startDate     DateTime
  endDate       DateTime
  shift         String // MORNING | AFTERNOON | NIGHT | FULL_DAY
  kind          String // COMMON | MEDICAL
  reason        String
  proofName     String?
  proofType     String?
  proofData     Bytes?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  autoApproved  Boolean   @default(false)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())

  user       User     @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([companyId, status])
  @@index([userId, startDate])
}

model Notice {
  id             String    @id @default(cuid())
  companyId      String
  authorId       String
  targetUserId   String? // null = todos os funcionários
  type           String // GENERAL | TERMINATION
  title          String
  message        String
  lastWorkingDay DateTime?
  createdAt      DateTime  @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User         @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  target  User?        @relation("Target", fields: [targetUserId], references: [id], onDelete: Cascade)
  reads   NoticeRead[]

  @@index([companyId, createdAt])
}

model NoticeRead {
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
}
