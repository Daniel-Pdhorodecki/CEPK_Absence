# Banco local (SQLite). Em produção usamos PostgreSQL no Neon.
DATABASE_URL="file:./dev.db"

# --- Produção (Neon + Render) ---
# No Render, preencha as duas variáveis no painel do Blueprint:
#
# DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# DATABASE_URL -> conexão pooled (aplicação)
# DIRECT_URL   -> conexão direta (prisma db push no build)

# Gere um valor aleatório para produção:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-este-valor"
